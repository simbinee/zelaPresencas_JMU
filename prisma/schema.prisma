generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  RESPONSAVEL
}

enum StatusCandidato {
  ATIVO
  INATIVO
}

model User {
  id           String       @id @default(cuid())
  nome         String
  username     String       @unique
  passwordHash String
  role         Role
  createdAt    DateTime     @default(now())
  marcacoes    Attendance[] @relation("MarcadoPor")
}

model AnoLetivo {
  id        String   @id @default(cuid())
  // ex: "2026/2027"
  nome      String   @unique
  // só um ano pode estar marcado como atual (é imposto no código, não no schema)
  atual     Boolean  @default(false)
  createdAt DateTime @default(now())
  turmas    Turma[]
}

model Turma {
  id          String      @id @default(cuid())
  nome        String
  anoLetivoId String
  createdAt   DateTime    @default(now())
  anoLetivo   AnoLetivo   @relation(fields: [anoLetivoId], references: [id], onDelete: Cascade)
  candidatos  Candidato[]

  // não pode haver duas turmas com o mesmo nome no mesmo ano letivo
  @@unique([anoLetivoId, nome])
}

model Candidato {
  id          String           @id @default(cuid())
  nome        String
  contacto    String?
  // DEPRECATED: turma antiga em texto livre. Mapeado para a coluna "turma"
  // já existente na base de dados para não perder os dados de produção —
  // é lida uma única vez pelo script prisma/migrar-turmas.ts e pode ser
  // removida (e a coluna eliminada com prisma db push) depois de migrada.
  turmaTextoAntigo String?     @map("turma")
  turmaId     String?
  turma       Turma?           @relation(fields: [turmaId], references: [id], onDelete: SetNull)
  status      StatusCandidato  @default(ATIVO)
  createdAt   DateTime         @default(now())
  attendances Attendance[]
}

model Evento {
  id                      String       @id @default(cuid())
  titulo                  String
  descricao               String?
  local                   String?
  data                    DateTime
  permiteMarcacaoAtrasada Boolean      @default(false)
  createdAt               DateTime     @default(now())
  attendances             Attendance[]
}

model Attendance {
  id           String    @id @default(cuid())
  eventoId     String
  candidatoId  String
  presente     Boolean   @default(false)
  observacao   String?
  marcadoPorId String?
  marcadoEm    DateTime  @updatedAt

  evento     Evento     @relation(fields: [eventoId], references: [id], onDelete: Cascade)
  candidato  Candidato  @relation(fields: [candidatoId], references: [id], onDelete: Cascade)
  marcadoPor User?      @relation("MarcadoPor", fields: [marcadoPorId], references: [id])

  @@unique([eventoId, candidatoId])
}
